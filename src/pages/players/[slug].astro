---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export async function getStaticPaths() {
  const players = await getCollection('players');
  return players.map((p) => ({ params: { slug: p.id }, props: { player: p } }));
}

const { player } = Astro.props;
const { Content } = await render(player);
const d = player.data;
---

<BaseLayout title={d.name} description={`${d.name}, Mahanaim FC ${d.positionDetail ?? d.position}. Squad number ${d.squadNumber ?? 'TBC'}.`}>
  <Fragment slot="header"><Header /></Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <section class="bg-mfc-black text-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <p class="font-body text-mfc-grey-400 text-sm mb-2"><a href="/players" class="hover:text-mfc-gold">Players</a> / {d.name}</p>
      <div class="flex flex-col md:flex-row md:items-end gap-6">
        <div>
          {d.squadNumber !== undefined && <p class="font-display text-7xl font-bold text-mfc-gold leading-none">{d.squadNumber}</p>}
          <h1 class="font-display font-bold uppercase text-4xl mt-2">{d.name}</h1>
          <p class="font-body text-mfc-grey-300 mt-2">{d.positionDetail ?? d.position} · {d.team}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <img src={d.photo} alt={`${d.name}, Mahanaim FC ${d.positionDetail ?? d.position}`} width="640" height="853" loading="eager" class="w-full max-w-xs rounded-lg object-cover object-top aspect-[3/4] bg-mfc-grey-100" />
      <div class="md:col-span-2">
        <table class="w-full text-sm font-body border-collapse mb-6">
          <tbody>
            <tr class="border-b border-mfc-grey-100"><th scope="row" class="text-left py-2 pr-4 font-semibold">Position</th><td class="py-2">{d.positionDetail ?? d.position}</td></tr>
            <tr class="border-b border-mfc-grey-100"><th scope="row" class="text-left py-2 pr-4 font-semibold">Squad</th><td class="py-2">{d.team}</td></tr>
            <tr class="border-b border-mfc-grey-100"><th scope="row" class="text-left py-2 pr-4 font-semibold">Shirt number</th><td class="py-2">{d.squadNumber ?? 'To be confirmed'}</td></tr>
            <tr class="border-b border-mfc-grey-100"><th scope="row" class="text-left py-2 pr-4 font-semibold">Nationality</th><td class="py-2">{d.nationality}</td></tr>
          </tbody>
        </table>
        <article class="font-body text-mfc-grey-800 leading-relaxed">
          <Content />
        </article>
        <p class="font-body text-xs text-mfc-grey-600 mt-6">Details are as published by the club and pending confirmation. Personal data beyond footballing information is not published — see our <a href="/club/governance" class="text-mfc-gold-hover font-semibold">governance page</a>.</p>
        <a href="/join" class="btn-gold mt-6 inline-flex">Apply for a trial</a>
      </div>
    </div>
  </div>
</BaseLayout>
