---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MatchTicker from '@/components/MatchTicker.astro';
import NewsCard from '@/components/NewsCard.astro';
import PlayerCard from '@/components/PlayerCard.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';

const players = (await getCollection('players'))
  .sort((a, b) => (a.data.squadNumber ?? 99) - (b.data.squadNumber ?? 99));
const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const results = (await getCollection('fixtures'))
  .filter((f) => f.data.status === 'Completed')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const lastResult = results[0];
---

<BaseLayout
  title="Home"
  description="Mahanaim Football Club — professional football development in Abuja, Nigeria. Developing players for personal excellence and team success. Est. 2018."
  ogImage="/images/badge/mahanaim-og.png"
>
  <Fragment slot="ticker">
    <MatchTicker
      nextOpponent="To be confirmed"
      nextDate="Watch this space"
      latestHomeTeam={lastResult ? (lastResult.data.isHome ? 'Mahanaim FC' : lastResult.data.opponent) : 'Mahanaim FC'}
      latestHomeScore={lastResult?.data.homeScore ?? 0}
      latestAwayScore={lastResult?.data.awayScore ?? 0}
      latestAwayTeam={lastResult ? (lastResult.data.isHome ? lastResult.data.opponent : 'Mahanaim FC') : ''}
      mobileDisplay="latest"
    />
  </Fragment>
  <Fragment slot="header"><Header /></Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <!-- Hero: one photograph, dark overlay -->
  <section class="relative bg-mfc-black text-white overflow-hidden">
    <img
      src="/images/about-club.jpg"
      alt="Mahanaim FC players and officials gathered on the pitch in Abuja"
      class="absolute inset-0 w-full h-full object-cover object-center opacity-35"
      width="1000"
      height="562"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-mfc-black via-mfc-black/70 to-mfc-black/30" aria-hidden="true"></div>
    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 md:pt-28 md:pb-24">
      <p class="font-body uppercase text-mfc-gold tracking-[0.25em] text-xs sm:text-sm font-bold mb-5">Football development in Abuja</p>
      <h1 class="display-hero max-w-4xl">
        Developing players for <span class="text-mfc-gold">personal excellence</span> and team success.
      </h1>
      <p class="font-body text-mfc-grey-300 max-w-2xl mt-6 text-base md:text-lg leading-relaxed">
        Mahanaim Football Club is an Abuja-based association football club that develops disciplined
        young players and builds pathways to competitive and professional football.
      </p>
      <div class="flex flex-wrap gap-4 mt-9">
        <a href="/join" class="btn-gold text-base px-8 py-4">Apply for a Trial</a>
        <a href="/club/story" class="btn-outline text-base">Explore the Club</a>
      </div>
    </div>
    <!-- Proof strip: verified facts only -->
    <div class="relative border-t border-mfc-grey-800/60 bg-mfc-black/80">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="stat-strip grid grid-cols-2 md:grid-cols-4 gap-6 py-8">
          <div><p class="stat-number">{players.length}</p><p class="stat-label mt-1">Squad players</p></div>
          <div><p class="stat-number">2018</p><p class="stat-label mt-1">Founded · Abuja</p></div>
          <div><p class="stat-number">{results.length}</p><p class="stat-label mt-1">Published results</p></div>
          <div><p class="stat-number">4</p><p class="stat-label mt-1">Official channels</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Fixture and result strip: next fixture omitted (none confirmed); latest verified result shown -->
  <section class="band-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-7">
        <div>
          <p class="section-kicker">Matchday</p>
          <h2 class="section-title">Latest result</h2>
        </div>
        <a href="/fixtures" class="font-display uppercase text-sm font-bold text-mfc-gold-hover tracking-wider hover:underline decoration-mfc-gold decoration-2 underline-offset-4">View all fixtures and results →</a>
      </div>
      {lastResult ? (
        <div class="card-lift bg-mfc-off-white border border-mfc-grey-100 p-6 md:p-8 grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
          <div>
            <p class="font-display uppercase text-sm font-bold text-mfc-grey-600 tracking-wider">{lastResult.data.competition}</p>
            <p class="font-body text-sm text-mfc-grey-600 mt-1">
              <time datetime={lastResult.data.date.toISOString()}>{lastResult.data.date.toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' })}</time>
            </p>
            <p class="font-body text-xs text-mfc-grey-600 mt-0.5">{lastResult.data.venue}</p>
          </div>
          <div class="text-center">
            <p class="font-display uppercase font-bold text-lg text-mfc-grey-800">{lastResult.data.isHome ? 'Mahanaim FC' : lastResult.data.opponent} <span class="text-mfc-grey-600 font-normal">vs</span> {lastResult.data.isHome ? lastResult.data.opponent : 'Mahanaim FC'}</p>
            <p class="score-big mt-2">{lastResult.data.homeScore} <span class="text-mfc-grey-300">–</span> <span class="gold">{lastResult.data.awayScore}</span></p>
          </div>
          <div class="md:text-right">
            {lastResult.data.matchReportSlug && <a href={`/news/${lastResult.data.matchReportSlug}`} class="btn-gold">Match report</a>}
            <p class="font-body text-xs text-mfc-grey-600 mt-3">As published by the club — details pending confirmation.</p>
          </div>
        </div>
      ) : (
        <p class="font-body text-mfc-grey-600">No results published yet.</p>
      )}
    </div>
  </section>

  <!-- The Mahanaim pathway: 4 neutral steps -->
  <section class="band-off-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="max-w-2xl mb-7">
        <p class="section-kicker">The Pathway</p>
        <h2 class="section-title">How a player joins Mahanaim</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        {['Submit an application', 'Receive a trial invitation if eligible', 'Attend assessment', "Receive the club's decision and onboarding information"].map((step, i) => (
          <div class="bg-white border border-mfc-grey-100 border-l-4 border-l-mfc-gold p-5">
            <p class="font-display font-bold text-mfc-gold text-3xl leading-none">0{i + 1}</p>
            <p class="font-body text-sm text-mfc-grey-800 mt-3 leading-relaxed">{step}</p>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-4 mt-7">
        <a href="/join" class="btn-gold">Start application</a>
        <a href="/join" class="btn-outline-dark">How trials work</a>
      </div>
      <p class="font-body text-xs text-mfc-grey-600 mt-4">Submitting an application does not guarantee an invitation or a contract.</p>
    </div>
  </section>

  <!-- Club introduction -->
  <section class="band-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="section-kicker">The Club</p>
        <h2 class="section-title mb-5">Abuja's developer of disciplined footballers</h2>
        <p class="font-body text-mfc-grey-800 leading-relaxed">
          Mahanaim Football Club is an association football team based in Abuja, Nigeria's capital city.
          Officially launched in 2018 (as stated by the club), it was born out of a passion to revitalise
          African football by returning to fundamentals — quality, longevity and ambition.
        </p>
        <div class="flex flex-wrap gap-4 mt-7">
          <a href="/club/story" class="btn-gold">Our Story</a>
          <a href="/club/leadership" class="btn-outline-dark">Leadership & Staff</a>
        </div>
      </div>
      <img src="/images/about-club.jpg" alt="Mahanaim FC squad and officials gathered on the pitch" width="1000" height="562" loading="lazy" class="w-full rounded-lg object-cover shadow-lg" />
    </div>
  </section>

  <!-- Development programmes: clean placeholders pending club information -->
  <section class="band-off-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="max-w-2xl mb-7">
        <p class="section-kicker">Development</p>
        <h2 class="section-title">Development programmes & teams</h2>
        <p class="font-body text-sm text-mfc-grey-600 mt-3">Programme details — age groups, training schedules, locations and fee policy — are published here once confirmed by the club. Nothing is shown until it is verified.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[1, 2, 3].map((i) => (
          <div class="bg-white border border-dashed border-mfc-grey-300 p-6">
            <p class="font-display uppercase font-bold text-sm text-mfc-grey-600 tracking-wider mb-3">Programme {i}</p>
            <ul class="list-none p-0 m-0 space-y-2 font-body text-sm text-mfc-grey-600">
              <li>Age group — <em>information required from club</em></li>
              <li>Training days & times — <em>information required from club</em></li>
              <li>Location — <em>information required from club</em></li>
              <li>Fee policy — <em>information required from club</em></li>
            </ul>
          </div>
        ))}
      </div>
      <p class="font-body text-xs text-mfc-grey-600 mt-5">In the meantime, <a href="/join" class="text-mfc-gold-hover font-semibold">apply for a trial</a> and the club will confirm the current programme structure with you directly.</p>
    </div>
  </section>

  <!-- Latest news -->
  <section class="band-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-7">
        <div>
          <p class="section-kicker">Newsroom</p>
          <h2 class="section-title">Latest news</h2>
        </div>
        <a href="/news" class="font-display uppercase text-sm font-bold text-mfc-gold-hover tracking-wider hover:underline decoration-mfc-gold decoration-2 underline-offset-4">All news →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {news.slice(0, 3).map((n, i) => (
          <NewsCard
            title={n.data.title}
            date={n.data.date}
            category={n.data.category}
            leadImage={n.data.leadImage}
            leadImageAlt={n.data.leadImageAlt}
            summary={n.data.summary}
            slug={n.id}
            featured={i === 0}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Featured players -->
  <section class="band-off-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-7">
        <div>
          <p class="section-kicker">The Squad</p>
          <h2 class="section-title">First-team players</h2>
        </div>
        <a href="/players" class="font-display uppercase text-sm font-bold text-mfc-gold-hover tracking-wider hover:underline decoration-mfc-gold decoration-2 underline-offset-4">All {players.length} players →</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {players.slice(0, 6).map((p) => (
          <PlayerCard name={p.data.name} position={p.data.position} positionDetail={p.data.positionDetail} squadNumber={p.data.squadNumber} photo={p.data.photo} slug={p.id} />
        ))}
      </div>
    </div>
  </section>

  <!-- Facilities and development: current vs planned -->
  <section class="band-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <p class="section-kicker">Development</p>
      <h2 class="section-title mb-7">Where we are, where we're going</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card-lift bg-mfc-off-white border border-mfc-grey-100 p-7">
          <p class="font-display uppercase font-bold text-sm text-mfc-grey-600 tracking-wider mb-3">Current training environment <span class="font-body normal-case font-normal text-xs">· in use now</span></p>
          <ul class="list-disc pl-5 font-body text-sm text-mfc-grey-800 space-y-2">
            <li>Training and matches on available pitches in Abuja</li>
            <li>Club office at Metta Plaza, Plot 100 Arab Road</li>
            <li>Match venues vary by fixture</li>
          </ul>
        </div>
        <div class="card-lift bg-mfc-off-white border border-mfc-grey-100 p-7">
          <p class="font-display uppercase font-bold text-sm text-mfc-grey-600 tracking-wider mb-3">Planned 13-hectare development <span class="font-body normal-case font-normal text-xs">· project status: proposed, not built</span></p>
          <ul class="list-disc pl-5 font-body text-sm text-mfc-grey-800 space-y-2">
            <li>Site near Nnamdi Azikiwe International Airport (as published)</li>
            <li>Training pitches, accommodation, dining and media facilities</li>
            <li>Flagship stadium — all stages proposed, no completion dates claimed</li>
          </ul>
        </div>
      </div>
      <a href="/club/facilities" class="font-display uppercase text-sm font-bold text-mfc-gold-hover tracking-wider mt-5 inline-block hover:underline decoration-mfc-gold decoration-2 underline-offset-4">Full facilities and development plan →</a>
    </div>
  </section>

  <!-- Media strip -->
  <section class="band-off-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-7">
        <div>
          <p class="section-kicker">Media</p>
          <h2 class="section-title">Inside the club</h2>
        </div>
        <a href="https://youtube.com/@mahanaimfcmedia844" target="_blank" rel="noopener noreferrer" class="font-display uppercase text-sm font-bold text-mfc-gold-hover tracking-wider hover:underline decoration-mfc-gold decoration-2 underline-offset-4">YouTube channel →</a>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[1, 2, 3, 4].map((i) => (
          <img src={`/images/gallery-g${i}.jpg`} alt={`Mahanaim FC — club photo ${i}`} width="800" height="600" loading="lazy" class="w-full h-44 md:h-52 object-cover rounded" />
        ))}
      </div>
      <div class="flex flex-wrap gap-6 mt-6 font-body text-sm">
        <a href="https://www.instagram.com/mahanaimfc2022/" target="_blank" rel="noopener noreferrer" class="text-mfc-gold-hover font-semibold">Instagram</a>
        <a href="https://www.facebook.com/profile.php?id=100083995110646" target="_blank" rel="noopener noreferrer" class="text-mfc-gold-hover font-semibold">Facebook</a>
        <a href="https://twitter.com/mahanaimFC" target="_blank" rel="noopener noreferrer" class="text-mfc-gold-hover font-semibold">X</a>
      </div>
    </div>
  </section>

  <!-- Closing Join CTA -->
  <section class="relative bg-mfc-black text-white overflow-hidden">
    <img src="/images/gallery-g3.jpg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover object-center opacity-25" width="800" height="600" loading="lazy" />
    <div class="absolute inset-0 bg-mfc-black/60" aria-hidden="true"></div>
    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 text-center">
      <p class="font-body uppercase text-mfc-gold tracking-[0.25em] text-xs font-bold mb-4">Join Mahanaim FC</p>
      <h2 class="display-hero text-white">Ready to take the next step?</h2>
      <p class="font-body text-mfc-grey-300 max-w-xl mx-auto mt-5 leading-relaxed">
        Apply for a trial and the club will confirm the next assessment date. Submitting an application
        does not guarantee an invitation or a contract.
      </p>
      <div class="flex flex-wrap gap-4 justify-center mt-8">
        <a href="/join" class="btn-gold text-base px-8 py-4">Apply for a Trial</a>
        <a href="https://wa.me/2349074700128?text=Hello%20Mahanaim%20FC%2C%20I%20would%20like%20to%20enquire%20about%20trials." target="_blank" rel="noopener noreferrer" class="btn-outline text-base">Ask on WhatsApp</a>
      </div>
    </div>
  </section>

  <WhatsAppButton />
</BaseLayout>
