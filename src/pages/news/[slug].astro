---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft);
  return posts.map((n) => ({ params: { slug: n.id }, props: { post: n } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const formatted = d.date.toLocaleDateString('en-GB', { timeZone: 'UTC', day: 'numeric', month: 'long', year: 'numeric' });
const shareUrl = `https://mahanaimfc.com/news/${post.id}`;
---

<BaseLayout title={d.title} description={d.summary} ogImage={d.leadImage}>
  <Fragment slot="header"><Header /></Fragment>
  <Fragment slot="footer"><Footer /></Fragment>

  <article class="container mx-auto px-4 sm:px-6 lg:px-8 py-10 max-w-3xl">
    <p class="font-body text-mfc-grey-600 text-sm mb-2"><a href="/news" class="hover:text-mfc-gold-hover">News</a> / {d.category}</p>
    <h1 class="font-display font-bold uppercase text-3xl md:text-4xl text-mfc-grey-800 leading-tight">{d.title}</h1>
    <p class="font-body text-sm text-mfc-grey-600 mt-3">
      <time datetime={d.date.toISOString()}>{formatted}</time> · {d.author} · <span class="bg-mfc-gold text-mfc-black px-2 py-0.5 font-display text-xs uppercase font-semibold">{d.category}</span>
    </p>
    <img src={d.leadImage} alt={d.leadImageAlt} width="900" height="506" loading="eager" class="w-full rounded mt-6 object-cover" />
    <div class="font-body text-mfc-grey-800 leading-relaxed mt-8">
      <Content />
    </div>
    <div class="mt-8 pt-6 border-t border-mfc-grey-100 font-body text-sm">
      <p class="text-mfc-grey-600 mb-2">Share:</p>
      <div class="flex gap-4">
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="text-mfc-gold-hover font-semibold">Facebook</a>
        <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(d.title)}&url=${encodeURIComponent(shareUrl)}`} target="_blank" rel="noopener noreferrer" class="text-mfc-gold-hover font-semibold">X</a>
        <a href={`https://wa.me/?text=${encodeURIComponent(d.title + ' ' + shareUrl)}`} target="_blank" rel="noopener noreferrer" class="text-mfc-gold-hover font-semibold">WhatsApp</a>
      </div>
    </div>
    <p class="mt-8"><a href="/fixtures" class="font-display uppercase text-sm font-bold text-mfc-gold-hover">Fixtures & results</a></p>
  </article>
</BaseLayout>
