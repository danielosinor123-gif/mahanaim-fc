---
interface Props {
  nextOpponent?: string;
  nextDate?: string;
  latestHomeTeam?: string;
  latestHomeScore?: number | string;
  latestAwayScore?: number | string;
  latestAwayTeam?: string;
  mobileDisplay?: 'next' | 'latest';
}

const {
  nextOpponent = 'To be confirmed',
  nextDate = 'Watch this space',
  latestHomeTeam = 'Mahanaim FC',
  latestHomeScore = 3,
  latestAwayScore = 1,
  latestAwayTeam = 'Kano Pillars',
  mobileDisplay = 'next',
} = Astro.props;
---

<aside
  class="bg-mfc-near-black text-white text-sm py-2 border-b border-mfc-grey-800/40 select-none"
  aria-label="Match Ticker"
>
  <div class="container flex items-center justify-between">
    <!-- Left side: Next Match info -->
    <div
      class:list={[
        'items-center gap-2 font-body text-xs sm:text-sm',
        mobileDisplay === 'next' ? 'flex' : 'hidden md:flex',
      ]}
    >
      <span class="font-body font-bold text-mfc-gold uppercase tracking-wider text-xs">
        Next Match:
      </span>
      <span class="text-white font-medium">
        {nextOpponent}
      </span>
      <span class="text-mfc-grey-600 hidden sm:inline">•</span>
      <span class="text-mfc-grey-300">
        {nextDate}
      </span>
    </div>

    <!-- Right side: Latest Match result -->
    <div
      class:list={[
        'items-center gap-1.5 sm:gap-2 font-body text-xs sm:text-sm',
        mobileDisplay === 'latest' ? 'flex' : 'hidden md:flex',
      ]}
    >
      <span class="font-body font-bold text-mfc-grey-300 uppercase tracking-wider text-xs">
        Latest:
      </span>
      <span class="text-white font-medium">
        {latestHomeTeam}
      </span>
      <span class="inline-flex items-center gap-1 px-1">
        <span class="font-display font-bold text-mfc-gold text-base tracking-tight leading-none">
          {latestHomeScore}
        </span>
        <span class="text-mfc-grey-300 font-body text-xs font-normal select-none">
          -
        </span>
        <span class="font-display font-bold text-mfc-gold text-base tracking-tight leading-none">
          {latestAwayScore}
        </span>
      </span>
      <span class="text-white font-medium">
        {latestAwayTeam}
      </span>
    </div>
  </div>
</aside>
