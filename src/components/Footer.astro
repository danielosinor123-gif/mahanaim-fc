---
interface Props {
  // Optional props if needed
}

const quickLinks = [
  { name: 'Home', href: '/' },
  { name: 'The Club', href: '/club' },
  { name: 'Players', href: '/players' },
  { name: 'Fixtures', href: '/fixtures' },
  { name: 'News', href: '/news' },
  { name: 'Join Mahanaim', href: '/join' },
  { name: 'Contact', href: '/contact' },
];
---

<footer class="bg-mfc-black text-mfc-white border-t border-mfc-grey-800 font-body">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10">
    <!-- Main 3-Column Desktop Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14">
      
      <!-- Column 1: Club Identity & Social Links -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img
            src="/images/badge/mahanaimfc.png"
            alt="Mahanaim FC badge"
            class="h-10 w-auto object-contain"
            width="40"
            height="40"
            loading="lazy"
          />
          <span class="font-display uppercase font-bold text-xl tracking-wider text-mfc-white">
            Mahanaim Football Club
          </span>
        </div>
        
        <p class="font-body text-sm text-mfc-grey-300 leading-relaxed max-w-sm">
          Professional football development in Abuja, Nigeria. Est. 2018.
        </p>

        <!-- Social Links Row -->
        <div class="pt-2">
          <p class="sr-only">Official Social Channels</p>
          <div class="flex items-center gap-3">
            <!-- YouTube Link -->
            <a
              href="https://youtube.com/@mahanaimfcmedia844"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center w-10 h-10 border border-mfc-grey-800 text-mfc-grey-300 hover:text-mfc-gold hover:border-mfc-gold transition-colors"
              aria-label="Mahanaim FC on YouTube (@Mahanaimfc)"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>

            <!-- Facebook Link -->
            <a
              href="https://www.facebook.com/profile.php?id=100083995110646"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center w-10 h-10 border border-mfc-grey-800 text-mfc-grey-300 hover:text-mfc-gold hover:border-mfc-gold transition-colors"
              aria-label="Mahanaim FC on Facebook"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <!-- Instagram Link -->
            <a
              href="https://www.instagram.com/mahanaimfc2022/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center w-10 h-10 border border-mfc-grey-800 text-mfc-grey-300 hover:text-mfc-gold hover:border-mfc-gold transition-colors"
              aria-label="Mahanaim FC on Instagram (@mahanaimfc2022)"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>

            <!-- X Link -->
            <a
              href="https://twitter.com/mahanaimFC"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center w-10 h-10 border border-mfc-grey-800 text-mfc-grey-300 hover:text-mfc-gold hover:border-mfc-gold transition-colors"
              aria-label="Mahanaim FC on X (Twitter) (@mahanaimFC)"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-7.017-4.99 7.017H2.656l7.73-8.835L1.259 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div>
        <h3 class="font-display uppercase font-bold text-lg tracking-wider text-mfc-white mb-5 border-l-2 border-mfc-gold pl-3">
          Quick Links
        </h3>
        <nav aria-label="Footer Quick Links">
          <ul class="grid grid-cols-2 sm:grid-cols-2 gap-y-3 gap-x-4 text-sm list-none p-0 m-0">
            {quickLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-body text-mfc-grey-300 hover:text-mfc-gold transition-colors inline-block focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mfc-gold"
                >
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Column 3: Contact Info -->
      <div>
        <h3 class="font-display uppercase font-bold text-lg tracking-wider text-mfc-white mb-5 border-l-2 border-mfc-gold pl-3">
          Contact Info
        </h3>
        <address class="not-italic">
          <ul class="space-y-3.5 text-sm list-none p-0 m-0">
            <!-- Location -->
            <li class="flex items-start gap-3 text-mfc-grey-300">
              <svg class="w-4 h-4 text-mfc-gold shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Metta Plaza, Suite FF7, Plot 100 Arab Road, Abuja 901002, FCT, Nigeria</span>
            </li>

            <!-- Phone (tel: protocol) -->
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 text-mfc-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <a
                href="tel:+2349074700128"
                class="text-mfc-grey-300 hover:text-mfc-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mfc-gold"
              >
                +234 907 470 0128
              </a>
            </li>

            <!-- WhatsApp (wa.me protocol) -->
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 text-mfc-gold shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2zm.01 17.89c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a7.925 7.925 0 0 1-1.22-4.22c0-4.41 3.59-8 8-8 2.14 0 4.15.83 5.66 2.34a7.96 7.96 0 0 1 2.35 5.66c0 4.41-3.59 8-8.02 8zm4.39-5.99c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.93-1.19-.71-.63-1.19-1.42-1.33-1.66-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42s-.54-1.3-.74-1.78c-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.24-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28z"/>
              </svg>
              <a
                href="https://wa.me/2349074700128"
                target="_blank"
                rel="noopener noreferrer"
                class="text-mfc-grey-300 hover:text-mfc-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mfc-gold"
              >
                +234 907 470 0128 (WhatsApp)
              </a>
            </li>

            <!-- Email (mailto: protocol) -->
            <li class="flex items-center gap-3">
              <svg class="w-4 h-4 text-mfc-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              <a
                href="mailto:mahanaimfc@hotmail.com"
                class="text-mfc-grey-300 hover:text-mfc-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mfc-gold"
              >
                mahanaimfc@hotmail.com
              </a>
            </li>
          </ul>
        </address>
      </div>

    </div>

    <!-- Divider Line Above Copyright Bar -->
    <div class="border-t border-mfc-grey-800 mt-12 pt-8">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-mfc-grey-300">
        <p class="text-center sm:text-left">
          Copyright Mahanaim Football Club. All Rights Reserved.
        </p>
        <div class="flex items-center gap-6">
          <a
            href="/privacy"
            class="hover:text-mfc-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mfc-gold"
          >
            Privacy Policy
          </a>
          <span class="text-mfc-grey-600" aria-hidden="true">&bull;</span>
          <a
            href="/safeguarding"
            class="hover:text-mfc-gold transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mfc-gold"
          >
            Safeguarding
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
